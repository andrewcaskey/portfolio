{
  "private": true,
  "name": "masterPortfolio",
  "version": "0.1.0",
  "homepage": "/",
  "scripts": {
    "build": "react-scripts build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d build",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy build --project-name=portfolio",
    "eject": "react-scripts eject",
    "start": "react-scripts start",
    "test": "react-scripts test"
  },
  "dependencies": {
    "apollo-boost": "^0.4.4",
    "baseui": "^9.65.3",
    "chart.js": "^2.9.3",
    "gh-pages": "^5.0.0",
    "node-fetch": "^2.6.0",
    "prettier-package-json": "^2.1.3",
    "react": "^16.10.2",
    "react-bootstrap": "^1.0.0-beta.16",
    "react-chartjs-2": "^2.9.0",
    "react-dom": "^16.10.2",
    "react-helmet": "^6.1.0",
    "react-markdown": "^5.0.3",
    "react-reveal": "^1.2.2",
    "react-router-dom": "^5.1.2",
    "react-scripts": "5.0.1",
    "remark-gfm": "^1.0.0",
    "styled-components": "^5.1.1",
    "styletron-engine-atomic": "^1.4.6",
    "styletron-react": "^5.2.7"
  },
  "devDependencies": {
    "dotenv": "^6.2.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "prettier": "2.0.5",
    "typescript": "^4.9.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.json": "prettier-package-json --write",
    "*.{js,css,md}": "prettier --write"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "serialize-javascript": "^7.0.5",
    "underscore": "^1.13.8"
  }
}
